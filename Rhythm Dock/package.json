{
  "name": "rhythm-dock-electron",
  "version": "1.7.1",
  "description": "A lightweight, feature-rich music player.",
  "main": "src/main/index.js",
  "homepage": "https://github.com/bestmahdi2/rhythm-dock-electron",
  "repository": {
    "type": "git",
    "url": "https://github.com/bestmahdi2/rhythm-dock-electron.git"
  },
  "scripts": {
    "start": "electron .",
    "icons": "node scripts/generate-icons.js",
    "prebuild": "npm run icons",
    "rebuild": "electron-builder install-app-deps",
    "dist": "npm run icons && electron-builder",
    "dist:current": "npm run icons && electron-builder --publish never",
    "build:win64": "npm run icons && electron-builder --win --x64",
    "build:win32": "npm run icons && electron-builder --win --ia32",
    "dist:win": "npm run icons && electron-builder --win --x64 --ia32 --arm64",
    "build:mac:x64": "npm run icons && electron-builder --mac --x64",
    "build:mac:arm64": "npm run icons && electron-builder --mac --arm64",
    "dist:mac": "npm run icons && electron-builder --mac --x64 --arm64",
    "build:linux:appimage": "npm run icons && electron-builder --linux AppImage --x64",
    "build:linux:deb": "npm run icons && electron-builder --linux deb --x64",
    "build:linux:rpm": "npm run icons && electron-builder --linux rpm --x64",
    "dist:linux": "npm run icons && electron-builder --linux --x64 --arm64",
    "dist:all": "npm run dist:win && npm run dist:mac && npm run dist:linux",
    "postinstall": "electron-builder install-app-deps",
    "test": "node tests/prepare-release.test.js && node tests/release-artifacts.test.js && node tests/installer-safety.test.js && node tests/audio-interruptions.test.js && node tests/file-icons.test.js && node tests/platform-audio.test.js && node tests/playback-open.test.js && node tests/platform-controls.test.js && node tests/roadmap-logic.test.js && node tests/discord-presence.test.js && node tests/edge-dock.test.js && node tests/remote-cache.test.js && node tests/remote-playlist.test.js && node tests/playlist-formats.test.js && node tests/library-scan.test.js && node tests/root-watcher.test.js && node tests/chapters.test.js && node tests/audio-outputs.test.js && node tests/audio-devices.test.js && node tests/media-tools.test.js && node tests/room-client-integration.test.js && node tests/room-restart-integration.test.js && npm run test:db-migration && npm --prefix ../server test",
    "test:db-migration": "electron tests/db-migration-smoke.js",
    "test:media-tools": "node tests/media-tools.test.js",
    "test:ui-smoke": "electron tests/pre-phase9-ui-smoke.js",
    "test:media-integration": "node tests/media-tools-integration.test.js",
    "test:roadmap": "node tests/roadmap-logic.test.js && npm run test:db-migration && npm run test:ui-smoke"
  },
  "keywords": [],
  "author": {
    "name": "Masterous",
    "email": "masterous@alibadiee.ir",
    "url": "https://alibadiee.ir"
  },
  "license": "ISC",
  "dependencies": {
    "better-sqlite3": "^12.2.0",
    "electron-store": "^7.0.0",
    "music-metadata": "^7.14.0",
    "node-taglib-sharp": "^5.2.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.1",
    "electron": "^31.2.1",
    "electron-builder": "^24.13.3",
    "png2icons": "^2.0.1",
    "sharp": "^0.33.5"
  },
  "build": {
    "appId": "com.masterous.rhythmdock",
    "productName": "Rhythm Dock",
    "copyright": "Copyright Â© 2025 Masterous",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "!src/**/*.map",
      "node_modules/**/*"
    ],
    "asarUnpack": [
      "**/src/assets/**",
      "**/node_modules/better-sqlite3/**",
      "**/src/main/services/native/**"
    ],
    "npmRebuild": true,
    "buildDependenciesFromSource": false,
    "fileAssociations": [
      {
        "ext": "mp3",
        "name": "MP3 Audio File",
        "description": "MP3 audio",
        "role": "Viewer",
        "mimeType": "audio/mpeg",
        "icon": "build/icons/filetypes/mp3"
      },
      {
        "ext": "m4a",
        "name": "M4A Audio File",
        "description": "MPEG-4 audio",
        "role": "Viewer",
        "mimeType": "audio/mp4",
        "icon": "build/icons/filetypes/m4a"
      },
      {
        "ext": "m4b",
        "name": "M4B Audiobook",
        "description": "MPEG-4 audiobook",
        "role": "Viewer",
        "mimeType": "audio/mp4",
        "icon": "build/icons/filetypes/m4b"
      },
      {
        "ext": "flac",
        "name": "FLAC Audio File",
        "description": "Free Lossless Audio Codec",
        "role": "Viewer",
        "mimeType": "audio/flac",
        "icon": "build/icons/filetypes/flac"
      },
      {
        "ext": "wav",
        "name": "WAV Audio File",
        "description": "Waveform audio",
        "role": "Viewer",
        "mimeType": "audio/wav",
        "icon": "build/icons/filetypes/wav"
      },
      {
        "ext": "ogg",
        "name": "OGG Audio File",
        "description": "Ogg Vorbis audio",
        "role": "Viewer",
        "mimeType": "audio/ogg",
        "icon": "build/icons/filetypes/ogg"
      },
      {
        "ext": "opus",
        "name": "Opus Audio File",
        "description": "Opus audio",
        "role": "Viewer",
        "mimeType": "audio/opus",
        "icon": "build/icons/filetypes/opus"
      },
      {
        "ext": "aac",
        "name": "AAC Audio File",
        "description": "Advanced Audio Coding",
        "role": "Viewer",
        "mimeType": "audio/aac",
        "icon": "build/icons/filetypes/aac"
      },
      {
        "ext": "wma",
        "name": "WMA Audio File",
        "description": "Windows Media audio",
        "role": "Viewer",
        "mimeType": "audio/x-ms-wma",
        "icon": "build/icons/filetypes/wma"
      },
      {
        "ext": "aiff",
        "name": "AIFF Audio File",
        "description": "Audio Interchange File Format",
        "role": "Viewer",
        "mimeType": "audio/aiff",
        "icon": "build/icons/filetypes/aiff"
      },
      {
        "ext": "mp4",
        "name": "MP4 Media File",
        "description": "MPEG-4 media",
        "role": "Viewer",
        "mimeType": "video/mp4",
        "icon": "build/icons/filetypes/mp4"
      },
      {
        "ext": "ape",
        "name": "APE Audio File",
        "description": "APE audio",
        "role": "Viewer",
        "mimeType": "audio/x-ape",
        "icon": "build/icons/filetypes/ape"
      },
      {
        "ext": "wv",
        "name": "WV Audio File",
        "description": "WV audio",
        "role": "Viewer",
        "mimeType": "audio/x-wavpack",
        "icon": "build/icons/filetypes/wv"
      },
      {
        "ext": "dsf",
        "name": "DSF Audio File",
        "description": "DSF audio",
        "role": "Viewer",
        "mimeType": "audio/x-dsf",
        "icon": "build/icons/filetypes/dsf"
      },
      {
        "ext": "dff",
        "name": "DFF Audio File",
        "description": "DFF audio",
        "role": "Viewer",
        "mimeType": "audio/x-dff",
        "icon": "build/icons/filetypes/dff"
      },
      {
        "ext": "mod",
        "name": "MOD Audio File",
        "description": "MOD audio",
        "role": "Viewer",
        "mimeType": "audio/x-mod",
        "icon": "build/icons/filetypes/mod"
      },
      {
        "ext": "xm",
        "name": "XM Audio File",
        "description": "XM audio",
        "role": "Viewer",
        "mimeType": "audio/x-xm",
        "icon": "build/icons/filetypes/xm"
      },
      {
        "ext": "it",
        "name": "IT Audio File",
        "description": "IT audio",
        "role": "Viewer",
        "mimeType": "audio/x-it",
        "icon": "build/icons/filetypes/it"
      },
      {
        "ext": "s3m",
        "name": "S3M Audio File",
        "description": "S3M audio",
        "role": "Viewer",
        "mimeType": "audio/x-s3m",
        "icon": "build/icons/filetypes/s3m"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32",
            "arm64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64",
            "ia32",
            "arm64"
          ]
        }
      ],
      "icon": "build/icons/icon.ico",
      "artifactName": "${productName} Setup ${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "menuCategory": false,
      "allowElevation": true,
      "include": "scripts/installer.nsh"
    },
    "portable": {
      "artifactName": "${productName} Portable ${version}-${arch}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icons/icon.icns",
      "category": "public.app-category.music",
      "darkModeSupport": true,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null,
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Not used.",
        "LSMultipleInstancesProhibited": true
      },
      "minimumSystemVersion": "10.15",
      "notarize": false
    },
    "dmg": {
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icons/linux",
      "category": "AudioVideo;Audio;Player",
      "synopsis": "A lightweight, feature-rich music player",
      "desktop": {
        "Name": "Rhythm Dock",
        "GenericName": "Music Player",
        "Comment": "A lightweight, feature-rich music player",
        "StartupWMClass": "Rhythm Dock",
        "Terminal": "false",
        "Type": "Application",
        "Categories": "AudioVideo;Audio;Player;Music;",
        "Keywords": "music;audio;player;mp3;flac;lyrics;",
        "MimeType": "audio/mpeg;audio/mp4;audio/flac;audio/wav;audio/x-wav;audio/ogg;audio/opus;audio/aac;audio/x-ms-wma;audio/aiff;audio/x-aiff;video/mp4;audio/x-rhythmdock-mp3;audio/x-rhythmdock-m4a;audio/x-rhythmdock-m4b;audio/x-rhythmdock-flac;audio/x-rhythmdock-wav;audio/x-rhythmdock-ogg;audio/x-rhythmdock-opus;audio/x-rhythmdock-aac;audio/x-rhythmdock-wma;audio/x-rhythmdock-aiff;audio/x-rhythmdock-mp4;audio/x-rhythmdock-ape;audio/x-rhythmdock-wv;audio/x-rhythmdock-dsf;audio/x-rhythmdock-dff;audio/x-rhythmdock-mod;audio/x-rhythmdock-xm;audio/x-rhythmdock-it;audio/x-rhythmdock-s3m;"
      },
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "maintainer": "Masterous <masterous@alibadiee.ir>",
      "description": "A lightweight, feature-rich music player with synced lyrics, an equalizer and a tag editor.",
      "mimeTypes": [
        "audio/mpeg",
        "audio/mp4",
        "audio/flac",
        "audio/wav",
        "audio/x-wav",
        "audio/ogg",
        "audio/opus",
        "audio/aac",
        "audio/x-ms-wma",
        "audio/aiff",
        "audio/x-aiff",
        "video/mp4",
        "audio/x-rhythmdock-mp3",
        "audio/x-rhythmdock-m4a",
        "audio/x-rhythmdock-m4b",
        "audio/x-rhythmdock-flac",
        "audio/x-rhythmdock-wav",
        "audio/x-rhythmdock-ogg",
        "audio/x-rhythmdock-opus",
        "audio/x-rhythmdock-aac",
        "audio/x-rhythmdock-wma",
        "audio/x-rhythmdock-aiff",
        "audio/x-rhythmdock-mp4",
        "audio/x-rhythmdock-ape",
        "audio/x-rhythmdock-wv",
        "audio/x-rhythmdock-dsf",
        "audio/x-rhythmdock-dff",
        "audio/x-rhythmdock-mod",
        "audio/x-rhythmdock-xm",
        "audio/x-rhythmdock-it",
        "audio/x-rhythmdock-s3m"
      ]
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libsecret-1-0"
      ],
      "fpm": [
        "--deb-field",
        "Suggests: ffmpeg"
      ],
      "afterInstall": "scripts/linux-after-install.sh",
      "afterRemove": "scripts/linux-after-remove.sh"
    },
    "rpm": {
      "depends": [
        "gtk3",
        "libnotify",
        "nss",
        "libXScrnSaver",
        "libXtst",
        "xdg-utils",
        "at-spi2-core",
        "libsecret"
      ],
      "fpm": [
        "--rpm-rpmbuild-define",
        "_build_id_links none"
      ],
      "afterInstall": "scripts/linux-after-install.sh",
      "afterRemove": "scripts/linux-after-remove.sh"
    },
    "appImage": {
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "extraResources": [
      {
        "from": "build/icons",
        "to": "build/icons",
        "filter": [
          "**/*"
        ]
      }
    ]
  }
}
