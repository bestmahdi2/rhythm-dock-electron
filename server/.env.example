# Copy to .env and edit before running docker compose.

# Required. Anyone with this string can create rooms on your server.
# Generate one with:  openssl rand -hex 24
CREATE_SECRET=change-me-to-a-long-random-string

# Optional. Maximum concurrent rooms.
MAX_ROOMS=50

# Optional. Keep this secret and supply it on the server only.
TELEGRAM_BOT_TOKEN=

# For a direct Node/systemd run, optionally set TELEGRAM_STATE_FILE to a writable
# absolute path. Docker Compose already stores this in its telegram-state volume.
# TELEGRAM_STATE_FILE=/var/lib/rhythm-dock/telegram-offset.json
